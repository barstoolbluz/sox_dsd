+def assignments(values):
+    result = {}
+    for item in values:
+        if '=' not in item:
+            raise ValueError('expected LABEL=PATH')
+        label, value = item.split('=', 1)
+        if not label or label in result:
+            raise ValueError('missing or duplicate label')
+        result[label] = Path(value)
+    return result
