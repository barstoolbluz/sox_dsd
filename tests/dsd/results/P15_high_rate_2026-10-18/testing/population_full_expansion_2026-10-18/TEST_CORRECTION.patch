+def exact_upper_endpoint(value):
+    """Decode the directed endpoint as a rational, without a binary64 cast."""
+    sign, mantissa, exponent, bits = value._mpi_[1]
+    if bits < 0:
+        raise ValueError("finite reference endpoint required")
+    return Fraction(-mantissa if sign else mantissa) * Fraction(2)**exponent
+
